# ==============================================
# 1CloudHub Tracker — Environment Variables
# Copy this to .env and fill in your values
# ==============================================

# Supabase (get from Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Backend (server-side only — never expose this)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ==============================================
# Auth-in-code — JWT signing
# Must match the asymmetric key pair registered as this project's JWT
# Signing Key in Supabase Dashboard -> Authentication -> JWT Keys, so
# PostgREST/RLS trusts tokens this backend mints.
# ==============================================
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KID=
JWT_ISSUER=https://your-project.supabase.co/auth/v1
JWT_AUDIENCE=authenticated
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==============================================
# Microsoft Entra ID (Azure AD) SSO
# ==============================================
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://your-api-url/api/auth/entra/callback
ENTRA_ADMIN_GROUP_ID=

FRONTEND_URL=http://localhost:5173

# ==============================================
# AWS SES — invite emails
# AWS credentials themselves come from the standard AWS credential chain
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / IAM role), not from this file.
# ==============================================
AWS_REGION=us-east-1
SES_SENDER_EMAIL=
